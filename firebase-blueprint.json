{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Student profile with registered hours and school details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Student ID or mobile", "maxLength": 128 },
        "name": { "type": "string", "description": "Student full name", "maxLength": 200 },
        "mobile": { "type": "string", "description": "Student mobile number", "maxLength": 30 },
        "stage": { "type": "string", "description": "Educational stage (primary/intermediate)", "enum": ["primary", "intermediate", "all"] },
        "grade": { "type": "string", "description": "Grade level", "maxLength": 100 },
        "classroom": { "type": "string", "description": "Classroom code (e.g. 5/1)", "maxLength": 50 },
        "schoolName": { "type": "string", "description": "School name", "maxLength": 200 },
        "totalHours": { "type": "number", "description": "Total confirmed volunteer hours" },
        "completedTasksCount": { "type": "number", "description": "Number of completed initiatives" },
        "registeredDate": { "type": "string", "description": "Date registered", "maxLength": 50 },
        "badgeLevel": { "type": "string", "description": "Badge level achieved", "maxLength": 100 }
      },
      "required": ["name", "mobile", "stage", "grade", "schoolName"]
    },
    "activityProgram": {
      "title": "ActivityProgram",
      "description": "Student activity program or initiative under central plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Program identifier", "maxLength": 128 },
        "name": { "type": "string", "description": "Program/Initiative name", "maxLength": 300 },
        "domain": {
          "type": "string",
          "description": "Activity domain category",
          "enum": [
            "cultural_arts",
            "citizenship_life",
            "health_sports",
            "scouts",
            "science_tech",
            "national_world_days",
            "educational_initiatives",
            "awards_competitions"
          ]
        },
        "domainName": { "type": "string", "description": "Localized domain name", "maxLength": 100 },
        "stage": { "type": "string", "description": "Educational stage", "enum": ["primary", "intermediate", "all"] },
        "stageLabel": { "type": "string", "description": "Localized stage label", "maxLength": 100 },
        "month": { "type": "string", "description": "Program month", "maxLength": 50 },
        "gregorianDate": { "type": "string", "description": "Date (Gregorian)", "maxLength": 50 },
        "hijriDate": { "type": "string", "description": "Date (Hijri)", "maxLength": 50 },
        "organizer": { "type": "string", "description": "Responsible entity/organizer", "maxLength": 200 },
        "description": { "type": "string", "description": "Program detailed description", "maxLength": 3000 },
        "status": { "type": "string", "description": "Program execution status", "enum": ["ongoing", "upcoming", "completed"] }
      },
      "required": ["name", "domain", "stage", "gregorianDate"]
    },
    "volunteerTask": {
      "title": "VolunteerTask",
      "description": "Volunteer initiative or activity opportunity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Task identifier", "maxLength": 128 },
        "programId": { "type": "string", "description": "Parent program ID", "maxLength": 128 },
        "programName": { "type": "string", "description": "Parent program name", "maxLength": 300 },
        "domain": { "type": "string", "description": "Activity domain", "maxLength": 64 },
        "title": { "type": "string", "description": "Initiative title", "maxLength": 250 },
        "description": { "type": "string", "description": "Initiative description", "maxLength": 2000 },
        "requiredSkills": { "type": "array", "description": "Required student skills" },
        "stage": { "type": "string", "description": "Eligible grade stage", "enum": ["primary", "intermediate", "all"] },
        "hours": { "type": "number", "description": "Volunteer hours credit" },
        "maxVolunteers": { "type": "number", "description": "Capacity limit" },
        "date": { "type": "string", "description": "Initiative date", "maxLength": 50 },
        "time": { "type": "string", "description": "Initiative time", "maxLength": 100 },
        "location": { "type": "string", "description": "Location at school", "maxLength": 200 },
        "supervisorName": { "type": "string", "description": "Supervisor name", "maxLength": 200 },
        "status": { "type": "string", "description": "Status of initiative", "enum": ["open", "in_progress", "completed", "cancelled"] },
        "checkInCode": { "type": "string", "description": "Passcode or check-in verification", "maxLength": 50 }
      },
      "required": ["title", "hours", "stage", "status"]
    },
    "volunteerRegistration": {
      "title": "VolunteerRegistration",
      "description": "Student registration and participation record for a volunteer task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Registration identifier", "maxLength": 128 },
        "taskId": { "type": "string", "description": "Associated task ID", "maxLength": 128 },
        "programId": { "type": "string", "description": "Associated program ID", "maxLength": 128 },
        "programName": { "type": "string", "description": "Associated program name", "maxLength": 300 },
        "studentId": { "type": "string", "description": "Student ID/mobile", "maxLength": 128 },
        "studentName": { "type": "string", "description": "Student name", "maxLength": 200 },
        "studentMobile": { "type": "string", "description": "Student mobile", "maxLength": 30 },
        "studentStage": { "type": "string", "description": "Stage of student", "enum": ["primary", "intermediate", "all"] },
        "registeredAt": { "type": "string", "description": "Registration timestamp", "maxLength": 64 },
        "attendanceStatus": { "type": "string", "description": "Attendance state", "enum": ["registered", "attended", "absent", "completed"] },
        "approvalStatus": { "type": "string", "description": "Supervisor approval status", "enum": ["pending", "approved", "rejected"] },
        "hoursAwarded": { "type": "number", "description": "Hours awarded" },
        "notes": { "type": "string", "description": "Supervisor or student notes", "maxLength": 1000 },
        "confirmedAt": { "type": "string", "description": "Confirmation date", "maxLength": 64 },
        "confirmedBy": { "type": "string", "description": "Supervisor who confirmed", "maxLength": 200 },
        "rating": { "type": "number", "description": "Student rating from 1 to 5" }
      },
      "required": ["taskId", "studentId", "studentName", "registeredAt", "attendanceStatus"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "Collection of enrolled students"
    },
    "/programs/{programId}": {
      "schema": "activityProgram",
      "description": "Collection of activity programs and initiatives"
    },
    "/tasks/{taskId}": {
      "schema": "volunteerTask",
      "description": "Collection of volunteer initiatives and tasks"
    },
    "/registrations/{registrationId}": {
      "schema": "volunteerRegistration",
      "description": "Collection of task participation and approvals"
    }
  }
}
