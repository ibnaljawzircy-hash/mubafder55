rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId);
      allow delete: if isValidId(studentId);
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update: if isValidId(programId);
      allow delete: if isValidId(programId);
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isValidId(taskId);
      allow delete: if isValidId(taskId);
    }

    match /registrations/{registrationId} {
      allow read: if true;
      allow create, update: if isValidId(registrationId);
      allow delete: if isValidId(registrationId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
